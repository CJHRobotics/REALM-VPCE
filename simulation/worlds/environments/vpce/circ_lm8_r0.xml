<?xml version="1.0" encoding="us-ascii"?>

<!-- Circular arena, radius 3 m, area 28.27 m^2, with 8 landmarks.
     XML `radius` is the inner walkable radius; the wall material
     extends outward by `thickness`. Panels sit on the inner face
     and are 0.75 m square. Interlandmark spacing along the wall
     is 2.36 m.

     Landmark bearings are anchored at 90 degrees:
     [90.0, 135.0, 180.0, 225.0, 270.0, 315.0, 360.0, 405.0]
     The robot captures at headings 0, 45 ... 315 with a 45-degree
     camera, so the views partition the circle at 22.5 + 45k. The
     earlier half-spacing convention put the 8 landmarks exactly on
     those boundaries. See make_area_sweep_envs.landmark_angles. -->

<world>
	<circular_wall radius="3" height="0.5" thickness="0.5" subdivision="128"/>

    <landmark type="panel" x=" 0.0000" y=" 2.9615" theta="-1.571" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_0.png"
              red="1.00" green="0.00" blue="0.00"/>
    <landmark type="panel" x="-2.0941" y=" 2.0941" theta="-0.785" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_1.png"
              red="0.00" green="1.00" blue="0.00"/>
    <landmark type="panel" x="-2.9615" y=" 0.0000" theta=" 0.000" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_2.png"
              red="0.00" green="0.00" blue="1.00"/>
    <landmark type="panel" x="-2.0941" y="-2.0941" theta=" 0.785" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_3.png"
              red="1.00" green="1.00" blue="0.00"/>
    <landmark type="panel" x=" 0.0000" y="-2.9615" theta=" 1.571" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_4.png"
              red="0.00" green="1.00" blue="1.00"/>
    <landmark type="panel" x=" 2.0941" y="-2.0941" theta=" 2.356" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_5.png"
              red="1.00" green="0.50" blue="0.00"/>
    <landmark type="panel" x=" 2.9615" y=" 0.0000" theta=" 3.142" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_6.png"
              red="0.50" green="0.00" blue="0.50"/>
    <landmark type="panel" x=" 2.0941" y=" 2.0941" theta=" 3.927" height="0.75" width="0.75"
              texture="../protos/world_objects/textures/flags/flag_7.png"
              red="0.00" green="0.50" blue="0.50"/>

    <train_start_positions>
        <pos x="0.0" y="0.0" theta="0.0"/>
    </train_start_positions>

    <test_start_positions>
        <pos x="0.0" y="0.0" theta="0.0"/>
    </test_start_positions>

    <goal id="0" x="0.0" y="0.0"/>
</world>
